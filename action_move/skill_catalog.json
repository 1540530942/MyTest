{
  "version": 1,
  "robot": "TurboPi",
  "notes": [
    "Camera look skills assume PWM servo 1 is pan and PWM servo 2 is tilt.",
    "Look skills use servo1=1000 for left and servo1=1700 for right after image-difference verification; 2000 can point too close to nearby objects.",
    "If the physical direction is inverted, swap the corresponding left/right or up/down positions in this catalog.",
    "Base movement uses /cmd_vel and always publishes stop after a timed burst.",
    "The original 0.10..0.12 movement values only converted to about 10..12 percent wheel speed, which can be below the physical movement threshold."
  ],
  "defaults": {
    "ros_container": "turbopi",
    "cmd_vel_topic": "/cmd_vel",
    "pwm_servo_topic": "/ros_robot_controller/pwm_servo/set_state",
    "move_duration_ms": 800,
    "servo_duration_s": 0.35,
    "pwm_center": 1500,
    "camera_server": "https://www.wangyutang.cn/camera",
    "capture_after_servo": true,
    "capture_after_move": false,
    "capture_settle_ms": 500
  },
