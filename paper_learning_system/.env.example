# App
APP_HOST=0.0.0.0
APP_PORT=8088
APP_DATA_DIR=/app/data
APP_DATABASE=/app/data/papers.db
PAPER_LEARNING_IMAGE=paper-learning-system:local
PAPER_HERMES_IMAGE=paper-hermes:local
PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=

# Hermes LLM gateway. Paper app calls Hermes first; if no provider key is set,
# the app falls back to deterministic local generation.
HERMES_URL=http://paper-hermes:8091
HERMES_API_TOKEN=
HERMES_PROVIDER_ORDER=
HERMES_TASK_ROUTES=
HERMES_HTTP_TIMEOUT_SECONDS=45
LLM_MINING_ENABLED=true

# OpenAI-compatible providers. Put real keys only in .env or server env files.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Paper mining
ARXIV_MAX_RESULTS=8
HTTP_TIMEOUT_SECONDS=20

# Public deployment
PUBLIC_BASE_URL=https://papers.example.com
API_TOKEN=change-me-before-public-deploy
