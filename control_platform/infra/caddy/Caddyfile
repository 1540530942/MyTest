{$WWW_DOMAIN} {
	encode zstd gzip
	reverse_proxy platform:8098
}

{$PLATFORM_DOMAIN} {
	encode zstd gzip
	reverse_proxy platform:8098
}

{$PAPERS_DOMAIN} {
	encode zstd gzip
	reverse_proxy paper-learning:8088
}

{$REMOTE_DOMAIN} {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy remote-control-api:8000
	}
	handle /devices/* {
		reverse_proxy remote-control-api:8000
	}
	handle {
		reverse_proxy remote-control-web:5173
	}
}

