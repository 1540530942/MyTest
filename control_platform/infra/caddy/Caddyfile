http://110.40.154.41 {
	encode zstd gzip
	handle_path /papers/api/* {
		rewrite * /api{path}
		reverse_proxy paper-learning:8088
	}
	handle_path /papers/static/* {
		rewrite * /static{path}
		reverse_proxy paper-learning:8088
	}
	handle /papers {
		redir /papers/ 308
	}
	handle /papers/* {
		reverse_proxy paper-learning:8088
	}
	handle /camera {
		redir /camera/ 308
	}
	handle_path /camera/static/* {
		rewrite * /static{path}
		reverse_proxy camera-snapshot:8099
	}
	handle_path /camera/api/* {
		rewrite * /api{path}
		reverse_proxy camera-snapshot:8099
	}
	handle_path /camera/* {
		reverse_proxy camera-snapshot:8099
	}
	handle /llm {
		redir /llm/ 308
	}
	handle_path /llm/static/* {
		rewrite * /static{path}
		reverse_proxy llm-manager:8092
	}
	handle_path /llm/api/* {
		rewrite * /api{path}
		reverse_proxy llm-manager:8092
	}
	handle_path /llm/* {
		reverse_proxy llm-manager:8092
	}
	handle {
		reverse_proxy platform:8098
	}
}

