ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

ARG PIP_INDEX_URL=

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY cloud_api/requirements.txt ./requirements.txt
RUN if [ -n "$PIP_INDEX_URL" ]; then python -m pip config set global.index-url "$PIP_INDEX_URL"; fi \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt

COPY cloud_api ./cloud_api
COPY device_bridge ./device_bridge

EXPOSE 8000

CMD ["uvicorn", "cloud_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
